<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.minidts</groupId>
  <artifactId>mini-dts</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>mini-dts</name>
  <description>MySQL→MySQL 迁移同步引擎：全量分片 + binlog 增量 + 断点续传 + 幂等回放 + CRC 校验</description>

  <modules>
    <module>mini-dts-common</module>
    <module>mini-dts-connector</module>
    <module>mini-dts-full</module>
    <module>mini-dts-store</module>
    <module>mini-dts-verifier</module>
    <module>mini-dts-cm</module>
    <module>mini-dts-starter</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.2.5</spring-boot.version>
    <binlog-connector.version>0.29.2</binlog-connector.version>
    <testcontainers.version>1.19.7</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.zendesk</groupId>
        <artifactId>mysql-binlog-connector-java</artifactId>
        <version>${binlog-connector.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Spring 6.1 参数名解析需要 -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <!--
        快速失败：JDK 不是 17+ 时立刻报一句人话，
        而不是等 surefire fork 出 "class file version 61.0 ... up to 52.0" 这种谜语。
        （根因：本仓库 release=17，Spring Boot 3.2 也要求 17+；用系统默认的 JDK 8 跑必挂。）
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>require-jdk-17</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>本仓库需要 JDK 17+（maven.compiler.release=17，Spring Boot 3.2 亦然）。
当前使用的是旧版 JDK。解决办法：
  1) ./mvn17 test        ← 仓库自带脚本，自动选 JDK 17
  2) export JAVA_HOME=~/jdk17 &amp;&amp; mvn test</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
