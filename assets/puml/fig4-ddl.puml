@startuml
skinparam dpi 160
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #64748b
skinparam ArrowThickness 2
skinparam activity {
  BackgroundColor #ffffff
  BorderColor #cbd5e1
  DiamondBackgroundColor #fef3c7
  DiamondBorderColor #fbbf24
}
title 源端改了表结构，mini-oms 怎么办？

start
:binlog 里出现一条 QUERY 事件\n（DDL 就藏在这里）;
:分类器看这条语句是什么;
if (事务控制语句？\nBEGIN / COMMIT / SET) then (是)
  :直接忽略;
  stop
else (否)
endif
if (纯追加列的 ALTER？\nALTER TABLE t ADD COLUMN …) then (是 · 白名单)
  :在目标库执行同一条语句;
  :重新读一遍表结构;
  :更新结构指纹基线;
  :继续同步（任务不中断）;
  stop
else (否)
  :写一条记录到目标库 oms_ddl_event\n（语句原文 + 原因）;
  :把任务置为 PAUSED;
  :等人看过、在目标库执行完再 resume;
  stop
endif
@enduml
